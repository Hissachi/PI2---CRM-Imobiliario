{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --env-file=.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "start": "bun run dist/index.js",
    "db:generate": "bun run --env-file=.env drizzle-kit generate",
    "db:migrate": "bun run --env-file=.env src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run --env-file=.env src/db/seed.ts",
    "lint": "echo \"lint: not configured yet\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/jwt": "^1.1.27",
    "@elysiajs/swagger": "^1.1.6",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.37.0",
    "elysia": "^1.1.27",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.29.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
