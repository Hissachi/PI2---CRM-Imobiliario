# Local: Postgres rodando em localhost (docker-compose ou instalação local).
# Produção (Vercel): use a CONNECTION STRING do banco hospedado, de preferência
# a do POOLER (Neon: host terminado em `-pooler`; Supabase: db.*.supabase.com:6543).
# Conexão direta (não-pooler) em serverless estoura o pool de conexões.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_imobiliaria
PORT=3000
JWT_SECRET=super-secret-key-change-in-production
# Produção: origem do frontend para CORS (ex.: https://seu-app.vercel.app).
# Local: http://localhost:3001 já está nas origens padrão do código.
CORS_ORIGIN=
NODE_ENV=development
