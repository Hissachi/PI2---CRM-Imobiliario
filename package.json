{
  "name": "crm-imobiliaria",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @crm/api dev",
    "dev:web": "pnpm --filter @crm/web dev",
    "build": "pnpm build:api && pnpm build:web",
    "build:api": "pnpm --filter @crm/api build",
    "build:web": "pnpm --filter @crm/web build",
    "db:generate": "pnpm --filter @crm/api db:generate",
    "db:migrate": "pnpm --filter @crm/api db:migrate",
    "db:push": "pnpm --filter @crm/api db:push",
    "db:studio": "pnpm --filter @crm/api db:studio",
    "db:seed": "pnpm --filter @crm/api db:seed",
    "db:create-admin": "pnpm --filter @crm/api db:create-admin",
    "lint": "pnpm --filter @crm/web lint",
    "contrast": "pnpm --filter @crm/web contrast",
    "typecheck": "pnpm --filter @crm/schemas typecheck && pnpm --filter @crm/api typecheck && pnpm --filter @crm/web typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "packageManager": "pnpm@10.33.0"
}